    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug executable 'vault'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=vault"
                ]
            },
            "args": []
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug WKC Test",
            "sourceLanguages": ["rust"],
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=chess_engine_2" // Change to "--bin=name" if testing a binary
                ],
                // This filter helps CodeLLDB pick the right artifact if multiple exist
                "filter": {
                    "kind": "bin" // Change to "bin" if testing a binary
                }
            },
            "args": ["test_make_move_fail_illegal"], // Arguments to pass to the test executable itself
            "cwd": "${workspaceFolder}"
        }
    ]
}